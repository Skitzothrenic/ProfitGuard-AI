{
  "name": "pantheonultimateparser",
  "version": "1.0.0",
  "description": "Pantheon MMO chat monitor and automation tool",
  "author": "Shem Smith",
  "main": "main.js",
  "scripts": {
    "test": "jest",
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.pantheon.parser",
    "productName": "PantheonUltimateParser",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "ui/build/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "babel-jest": "^30.0.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "tmp": "^0.2.3"
  }
}
